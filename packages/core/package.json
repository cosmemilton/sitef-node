{
  "name": "@cosmemilton/sitef",
  "version": "0.3.0",
  "description": "SDK Node.js para CliSiTef com ponte nativa isolada e interação customizável",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fields": {
      "types": "./dist/fields.d.ts",
      "import": "./dist/fields.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmemilton/sitef-node.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/cosmemilton/sitef-node#readme",
  "bugs": {
    "url": "https://github.com/cosmemilton/sitef-node/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
