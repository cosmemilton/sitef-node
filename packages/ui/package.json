{
  "name": "@cosmemilton/sitef-ui",
  "version": "0.3.0",
  "description": "Modal React opcional de interação CliSiTef com cosmemilton-ui",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./controller": {
      "types": "./dist/controller.d.ts",
      "import": "./dist/controller.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "peerDependencies": {
    "@cosmemilton/sitef": "^0.3.0",
    "@iconify/react": ">=5",
    "cosmemilton-ui": "^4.1.0",
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmemilton/sitef-node.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/cosmemilton/sitef-node#readme",
  "bugs": {
    "url": "https://github.com/cosmemilton/sitef-node/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
